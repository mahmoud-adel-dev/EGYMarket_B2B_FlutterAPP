* text=auto

# Keep documentation and cross-platform source files deterministic and UTF-8 friendly.
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.dart text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets must never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
