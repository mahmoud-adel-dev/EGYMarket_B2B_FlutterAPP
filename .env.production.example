# =============================================================================
# SEALS production environment — copy to `.env.production` next to this file
# and fill in real values. NEVER commit the filled copy.
# =============================================================================

# --- Public domains (Caddy obtains Let's Encrypt certificates automatically) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Flutter Web build ---
# The API URL baked into the browser bundle at build time (must be https://).
WEB_API_BASE_URL=https://api.example.com/api

# =============================================================================
# Everything below goes into backend/.env.production
# =============================================================================

# --- Backend core ---
NODE_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority

# Generate with: openssl rand -base64 48   (minimum 32 characters)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://api.example.com
APP_ORIGIN=https://app.example.com
# Optional comma-separated additional trusted origins for CORS.
APP_ORIGINS=

# Rate limiting trust model: true ONLY when requests arrive through Caddy,
# which overwrites X-Forwarded-For with the real client address.
TRUST_PROXY_HEADERS=true

# --- Cloudinary (media uploads; required in production) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (email verification / password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SEALS B2B <no-reply@example.com>"

# Scheduled maintenance job credential (32+ random characters).
CRON_SECRET=
ALLOW_UNVERIFIED_LOGIN=false
LOG_LEVEL=info

# One-time admin bootstrap (`npm run bootstrap:admin`); remove values afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Admin
