# Optional: omit both variables to use an ephemeral local MongoDB replica set.
#
# External execution is destructive. The harness creates a run-specific database
# derived from the safe database name below, deletes its contents, and drops it.
# The base database name MUST contain test, integration, ci, or chaos.
MONGODB_URI=mongodb+srv://memoadeldev_db_user:R0Oxo4PSIk5yIzVn@cluster0.nlycilg.mongodb.net/b2bmar
MONGODB_TEST_ALLOW_EXTERNAL=I_UNDERSTAND_THIS_DROPS_TEST_DATA

# Optional deterministic stress controls.
PURCHASE_CHAOS_ROUNDS=3
PURCHASE_CHAOS_CONCURRENCY=24

