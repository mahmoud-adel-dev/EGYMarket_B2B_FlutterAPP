# Copy to .env.local for local development. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/seals_b2b
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:8080

# Required for real media uploads. The API refuses fake URLs when these are absent.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional in local development; required before production email verification is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Seals B2B <no-reply@example.com>"

# Never set true in production.
ALLOW_UNVERIFIED_LOGIN=false
LOG_LEVEL=info
